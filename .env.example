# =============================================================================
# doge-identity-service — example environment
# Copy to `.env` locally. Do not commit real secrets.
# Handbook (секреты, local vs pilot, OAuth): docs/runbook/env-secrets-handbook.md
# =============================================================================

# --- Deployment ---
APP_PROFILE=demo
PORT=8100
API_BASE_URL=http://localhost:8100
LOG_LEVEL=INFO
LOG_FORMAT=text
REQUEST_TIMEOUT_S=15
OIDC_REQUEST_TIMEOUT_S=10

# --- Database backend ---
# in_memory — local dev without PostgREST (default)
# supabase  — PostgREST via SUPABASE_URL + SUPABASE_SERVICE_ROLE (see docs/runbook/supabase-project-setup.md)
DB_BACKEND=in_memory

# --- Supabase (required when DB_BACKEND=supabase) ---
# Project URL: Supabase Dashboard -> Settings -> API -> Project URL
SUPABASE_URL=

# Service role key (server only, never in browser)
SUPABASE_SERVICE_ROLE=

# Direct Postgres connection (for psycopg; optional for PostgREST client)
# postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# --- CI / live_integration (separate Supabase project — EPIC-IDS-06) ---
# Never use production SUPABASE_URL for test-live. Create a dedicated test project.
# GitHub Secrets: SUPABASE_TEST_URL, SUPABASE_TEST_SERVICE_ROLE_KEY
# Local override example (uncomment for make test-live against test project):
# SUPABASE_TEST_URL=https://<test-project-ref>.supabase.co
# SUPABASE_TEST_SERVICE_ROLE=<test_service_role_key>
# SUPABASE_TEST_ACCESS_TOKEN=<optional operator ES256 access token for JWT live sanity>

# --- Authentigate OIDC ---
# Demo environment (use mock-oauth2-server for local dev):
#   docker run -p 8080:8080 ghcr.io/navikt/mock-oauth2-server:latest
# Demo: AUTHENTIGATE_ISSUER=https://oidc.demo.sk.ee
# Production: AUTHENTIGATE_ISSUER=https://id.authentigate.eu
AUTHENTIGATE_ISSUER=https://oidc.demo.sk.ee
AUTHENTIGATE_DISCOVERY_URL=
AUTHENTIGATE_CLIENT_ID=
AUTHENTIGATE_CLIENT_SECRET=
AUTHENTIGATE_REDIRECT_URI=http://localhost:8100/auth/authentigate/callback
AUTHENTIGATE_SCOPES=openid https://id.authentigate.eu/claims/personal_code https://id.authentigate.eu/claims/personal_code_country
AUTHENTIGATE_ACR_VALUES=sid_ee mid_ee idcard_ee
AUTHENTIGATE_UI_LOCALES=et en
AUTHENTIGATE_COUNTRY=EE

# --- Identity Provider ---
EID_PROVIDER=mock
NODE_ID=tallinn

# --- Phone verification (ядро, provider-agnostic) ---
SMS_PROVIDER=mock                       # активный провайдер: mock | file | telnyx
PHONE_ALLOWED_DIAL_PREFIXES=+372        # разрешённые дозвонные префиксы E.164, список через запятую (фильтр в ядре ДО отправки)
PHONE_CODE_LENGTH=6                     # длина OTP
PHONE_CODE_TTL_S=300                    # срок жизни кода (5 минут)
PHONE_MAX_ATTEMPTS=5                    # попыток ввода кода до блокировки сессии
PHONE_RESEND_COOLDOWN_S=60              # минимум между повторными отправками (анти-спам SMS)
PHONE_ONE_ACCOUNT_PER_NUMBER=true       # один номер = один аккаунт (дедупликация)

# --- File SMS sink (dev-only при SMS_PROVIDER=file; plaintext OTP на диск — никогда prod/pilot) ---
FILE_SMS_OUTBOX_DIR=var/sms-outbox

# --- Telnyx (заполнить при SMS_PROVIDER=telnyx) ---
TELNYX_API_KEY=
TELNYX_API_BASE_URL=https://api.telnyx.com
TELNYX_FROM=DOGEstonia                  # буквенный отправитель (alphanumeric sender ID)
TELNYX_MESSAGING_PROFILE_ID=            # обязателен при буквенном TELNYX_FROM
TELNYX_MESSAGE_TYPE=SMS                  # optional: SMS (default)
TELNYX_ENCODING=auto                     # optional: auto | gsm7 | ucs2
TELNYX_WEBHOOK_PUBLIC_KEY=               # Ed25519 public key (base64) for POST /webhooks/telnyx/messaging
# (другой SMS-провайдер позже — свой блок, как у eID EIDEASY_*/AUTHENTIGATE_*)

# --- eID Easy (fill when EID_PROVIDER=eideasy) ---
EIDEASY_ENV=test
EIDEASY_BASE_URL=https://test.eideasy.com
EIDEASY_CLIENT_ID=
EIDEASY_CLIENT_SECRET=
EIDEASY_REDIRECT_URI=http://localhost:8100/auth/eideasy/callback
EIDEASY_ALLOWED_METHODS=smartid,mid-login,ee-id-login
EIDEASY_DEFAULT_COUNTRY=EE
EIDEASY_ALLOWED_COUNTRIES=EE

# --- Identity Secrets ---
# HMAC secret for verified_person_hash / subject_hash (приватный; уникален на среду):
# python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Куда: только identity .env / Railway Variables. Pilot: обязателен.
DOGESTONIA_EID_SECRET=

# Fernet key for EID session encryption (приватный; pilot: обязателен; demo: встроенный дефолт):
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Куда: только identity .env / Railway Variables.
EID_SESSION_ENC_KEY=

# --- OAuth 2.0 Server (identity как Authorization Server для Custom GPT) ---
# Не путать с GPT Actions Bearer на gateway (GPT_ACTIONS_BEARER_SECRET).
# Дверь A (stash+redirect): GPT не вызывает эти vars напрямую, но pilot требует их для старта.
# Дверь B (OAuth bridge): GPT_OAUTH_* дублируются в ChatGPT OAuth settings — см. env-secrets-handbook.md §5.

# Приватный ключ подписи OAuth access-token JWT (pilot: обязателен):
# python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
OAUTH_ACCESS_TOKEN_SECRET=
OAUTH_ACCESS_TOKEN_TTL_S=3600          # срок жизни access token, сек (дефолт 1 ч)
OAUTH_AUTHORIZATION_CODE_TTL_S=300     # срок жизни auth code, сек (дефолт 5 мин)

# Идентификатор OAuth-клиента ChatGPT («логин», не секрет; не генерировать):
GPT_OAUTH_CLIENT_ID=openai-custom-gpt
# Пароль клиента (приватный; pilot: обязателен). Одна строка — не путать с OAUTH_ACCESS_TOKEN_SECRET.
# При двери B: то же значение в ChatGPT OAuth → Client Secret. Client ID = GPT_OAUTH_CLIENT_ID выше.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GPT_OAUTH_CLIENT_SECRET=
# Callback OpenAI (константа; одинакова везде; не генерировать):
GPT_OAUTH_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# --- Service trust ---
# Служебный пароль для POST /oauth/introspect (server-to-server). Генерируете сами; pilot: обязателен.
# Не путать с SERVICE_API_TOKEN на gateway — другой сервис, другое сгенерированное значение.
# См. docs/runbook/env-secrets-handbook.md §6 (Service trust).
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_TOKEN=

# --- CORS ---
# См. docs/runbook/cors-allowed-origins.md — что ставить локально и на Railway
# Production: CORS_ALLOWED_ORIGINS=https://dogestonia-spa-tallinn-demo.up.railway.app,https://chat.openai.com
# Local dev (Vite :5173): CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=*
ALLOWED_RETURN_URLS=
